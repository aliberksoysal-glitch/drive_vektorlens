# Kopyalayın: copy .env.example .env.local

# OAuth 2.0 — ozelvektorosgb@gmail.com hesabı üzerinden Drive erişimi
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Refresh token alırken kullandığınız redirect URI (OAuth Playground: https://developers.google.com/oauthplayground)
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# İsteğe bağlı: ayarlıysa /api/drive/* istekleri X-API-Key, Authorization: Bearer veya
# /unlock ile verilen vl_session çerezi ile doğrulanır.
# Tarayıcı için ayrı PIN: APP_UI_PIN (yoksa APP_API_KEY ile aynı sayılır).
# APP_API_KEY=

# İsteğe bağlı: yükleme olaylarını bu URL'ye JSON POST eder (Make/Slack webhook vb.)
# ACTIVITY_WEBHOOK_URL=

# İsteğe bağlı: yükleme dosya adı şablonu (istemci). Yer tutucular: {business} {visit} {index} {ext} {yyyy} {mm} {dd} {date} {time}
# NEXT_PUBLIC_UPLOAD_FILENAME_TEMPLATE={business}-{visit}-{index}.{ext}
