# Kopyalayın: copy .env.example .env.local

# OAuth 2.0 — ozelvektorosgb@gmail.com hesabı üzerinden Drive erişimi
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Refresh token alırken kullandığınız redirect URI (OAuth Playground: https://developers.google.com/oauthplayground)
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
